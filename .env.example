JWT_SECRET_KEY= < Create a JWT Secret Key >
ENVIRONMENT=< local for development| staging | production >
BACKEND_CORS_ORIGINS=<Your Frontend URL (Can be multiple seperated by comma or list)>
POSTGRESQL_USERNAME=< Your Postgres Username >
POSTGRESQL_PASSWORD=< Your Postgres Password >
POSTGRESQL_SERVER=< Your Postgres Server IP >
POSTGRESQL_PORT=< Your Postgres Port >
POSTGRESQL_DATABASE=< Your Postgres Database, preferably Planorama >
DOMAIN=< Your Backend URL >
ORS_API_KEY= < Your Open Route Service API Key >
AI_API_KEY= < Your perplexity.ai sonar reasoning model API key > (if you want to use AI suggestions, has to be the paid model)
VITE_BACKEND_URL=< Your Backend URL >
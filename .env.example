# JWT Secret Key - Generate a secure random key (e.g., using: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secret-key-here-generate-a-secure-one

# Environment: local, staging, or production
ENVIRONMENT=local

# CORS Origins - Frontend URLs that can access the backend (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# PostgreSQL Database Configuration
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_SERVER=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=Planorama

# Backend Domain (for local development, use localhost:8000)
DOMAIN=localhost:8000

# API Keys
# Get your OpenRouteService API key from: https://openrouteservice.org/dev/#/account
ORS_API_KEY=your-ors-api-key-here

# Get your Perplexity AI API key from: https://www.perplexity.ai/settings/api
# Note: AI suggestions require a paid Perplexity account
AI_API_KEY=your-perplexity-api-key-here

# Frontend Backend URL (used by Vite during build)
VITE_BACKEND_URL=http://localhost:8000

# Admin User (for initial seeding on first startup)
# The admin user will be created automatically if ADMIN_PASSWORD is set
ADMIN_EMAIL=admin@planorama.com
ADMIN_USERNAME=admin
# Password must meet requirements: min 8 chars, uppercase, lowercase, number, symbol
ADMIN_PASSWORD=YourSecurePassword123!

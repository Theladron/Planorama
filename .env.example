# Backend Configuration
ENVIRONMENT=local
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
POSTGRESQL_USERNAME=postgres
POSTGRESQL_PASSWORD=postgres
POSTGRESQL_SERVER=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=Planorama

# Domain Configuration
DOMAIN=localhost:8000

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# API Keys
ORS_API_KEY=
AI_API_KEY=

# Admin User Configuration (for seeding)
# These will be used to create/fetch the admin user in Auth0 during startup
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Auth0 Configuration
# Domain of your Auth0 tenant (e.g., dev-xxxxx.us.auth0.com)
AUTH0_DOMAIN=
# API Audience/Identifier for your Auth0 API
AUTH0_AUDIENCE=https://api.planorama
# Client ID and Secret for your Auth0 SPA Application
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Management API credentials (M2M Application)
# Required for user creation, role assignment, and admin seeding
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Auth0 database connection name (default: Username-Password-Authentication)
AUTH0_CONNECTION_NAME=Username-Password-Authentication